{
    "name": "kristijorgji/php-coding-standard",
    "description": "PHPCS house coding standard (Slevomat-based) plus optional shared git pre-commit hooks",
    "type": "phpcodesniffer-standard",
    "version": "0.2.2",
    "license": "MIT",
    "authors": [
        {
            "name": "Kristi Jorgji",
            "homepage": "https://www.kristijorgji.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7 || ^1.0",
        "slevomat/coding-standard": "^8.13",
        "squizlabs/php_codesniffer": "^3.7 || ^4.0"
    },
    "bin": [
        "bin/kj-php-coding-standard-install-hooks"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
