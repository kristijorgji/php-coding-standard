{
    "name": "kristijorgji/php-coding-standard",
    "description": "PHPCS/ECS house coding standard (Slevomat-based) plus optional shared git pre-commit hooks",
    "type": "phpcodesniffer-standard",
    "version": "0.3.7",
    "license": "MIT",
    "authors": [
        {
            "name": "Kristi Jorgji",
            "homepage": "https://www.kristijorgji.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7 || ^1.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "kubawerlos/php-cs-fixer-custom-fixers": "^3.0",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0.1",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.0 || ^8.0"
    },
    "bin": [
        "bin/kj-php-coding-standard-coverage-check",
        "bin/kj-php-coding-standard-install-hooks",
        "bin/kj-php-coding-standard-yaml-lint"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
