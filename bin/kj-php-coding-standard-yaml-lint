#!/usr/bin/env php
<?php declare(strict_types = 1);

/**
 * Parse one or more YAML files; fail if any are missing or invalid.
 *
 * Usage:
 *   kj-php-coding-standard-yaml-lint <file.yml> [file2.yml ...]
 *
 * Exit codes:
 *   0 — every file exists and parses
 *   1 — usage error, or at least one file missing/invalid
 */

$autoloadCandidates = [
    dirname(__DIR__, 3) . '/autoload.php',
    dirname(__DIR__) . '/vendor/autoload.php',
];

$autoload = null;
foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}

if ($autoload === null) {
    fwrite(STDERR, "ERROR: could not find Composer autoload.php\n");
    exit(1);
}

require $autoload;

use Symfony\Component\Yaml\Exception\ParseException;
use Symfony\Component\Yaml\Yaml;

if ($argc < 2) {
    fwrite(STDERR, "Usage: kj-php-coding-standard-yaml-lint <file.yml> [file2.yml ...]\n");
    exit(1);
}

$failed = 0;
for ($i = 1; $i < $argc; $i++) {
    $file = $argv[$i];
    if (!is_file($file)) {
        fwrite(STDERR, "MISSING {$file}\n");
        $failed++;
        continue;
    }
    try {
        Yaml::parseFile($file);
        fwrite(STDOUT, "OK {$file}\n");
    } catch (ParseException $e) {
        fwrite(STDERR, "FAIL {$file}: {$e->getMessage()}\n");
        $failed++;
    }
}

exit($failed > 0 ? 1 : 0);
